<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- main container layout with vertical orientation and padding -->
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- input field for full name -->
        <EditText
            android:id="@+id/edtFullName"
            android:hint="full name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- radio group for selecting gender -->
        <RadioGroup
            android:id="@+id/genderGroup"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <!-- option male -->
            <RadioButton android:text="male" android:id="@+id/rbMale"/>
            <!-- option female -->
            <RadioButton android:text="female" android:id="@+id/rbFemale"/>
        </RadioGroup>

        <!-- input field for year of birth, only allows numbers -->
        <EditText
            android:id="@+id/edtYear"
            android:hint="year of birth"
            android:inputType="number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- input field for username -->
        <EditText
            android:id="@+id/edtUsername"
            android:hint="username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- input field for password, hides input text -->
        <EditText
            android:id="@+id/edtPassword"
            android:hint="password"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- input field to re-enter password for confirmation -->
        <EditText
            android:id="@+id/edtRePassword"
            android:hint="re-enter password"
            android:inputType="textPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- register button to submit the form -->
        <Button
            android:id="@+id/btnRegister"
            android:text="register"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
